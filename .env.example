# GrowPath does not require a database or an account. The analyzer works with
# public HTTPS offers or a description pasted manually.

# Optional inference artifacts. These are server-only settings: never use a
# VITE_ prefix and never put OCI credentials in this file. Parsing this config
# does not download or execute either model.
# MODEL_SOURCE=local
# JOBBERT_MODEL_DIR=/models/jobbert-v3
# QWEN_MODEL_PATH=/models/qwen3/Qwen3-1.7B-Q4_K_M.gguf
# Optional deployment-local inference service. It is never sent to the browser.
# MODEL_RUNTIME_URL=http://model-runtime:8090
#
# For a deployment-specific model initializer, identify the fixed private OCI
# objects. It must authenticate server-side and mount verified files at the
# two paths above; GrowPath does not install or invoke the OCI CLI.
# MODEL_SOURCE=oci
# OCI_REGION=us-ashburn-1
# OCI_BUCKET_NAME=Bucket-Rnz
# JOBBERT_OBJECT=models/JobBERT-v3.tar.gz
# QWEN_OBJECT=models/Qwen3-1.7B-Q4_K_M.gguf
# OCI_AUTH_MODE=config
