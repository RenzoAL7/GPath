# GPath runs in live mode by default and reads public Greenhouse, Lever and Ashby job feeds.
# Use JOB_MODE=demo only for deterministic local screenshots or tests.
# JOB_MODE=live
# Optional: comma-separated board tokens/sites; labels after ':' are optional.
# GREENHOUSE_BOARDS=stripe:Stripe,vercel:Vercel,cloudflare:Cloudflare,datadog:Datadog
# LEVER_SITES=deuna:DEUNA,xepelin:Xepelin,solopulseco:SoloPulse,shopback-2:ShopBack
# ASHBY_BOARDS=notion:Notion,perplexity:Perplexity,modal:Modal
# JOBS_CACHE_SECONDS=900
# JOBS_MAX_PER_SOURCE=6

# No database is required for local development.
# Optional, server-only: read-only PAR URL for the single OCI object
# gpath/releases/index.json. Treat it as a secret. Never use a VITE_ prefix.
# RELEASE_CATALOG_URL=https://objectstorage.REGION.oraclecloud.com/p/REDACTED/n/NAMESPACE/b/BUCKET/o/gpath/releases/index.json

# Optional publisher (uses the OCI CLI identity already configured locally).
# OCI_RELEASE_BUCKET=your-bucket
# OCI_RELEASE_NAMESPACE=your-namespace
