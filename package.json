{
  "name": "gitpath",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env.local server/index.mjs",
    "release": "node scripts/write-release.mjs",
    "build": "npm run release && npm run build:web",
    "build:web": "node scripts/copy-licenses.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "archive": "node --env-file-if-exists=.env.local scripts/publish-archive.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.9.6",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "yaml": "2.9.0"
  }
}
